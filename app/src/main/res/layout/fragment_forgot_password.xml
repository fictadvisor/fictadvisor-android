<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/spinner_group"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:theme="@style/Theme.MaterialComponents"
    android:background="@drawable/background"
    tools:context=".ui.RegistrationFragment">

    <TextView
        android:id="@+id/textViewForgotPassword1"
        style="@style/TextViewStyle_Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Забув пароль?"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.111" />


    <TextView
        android:id="@+id/textViewForgotPassword2"
        style="@style/TextViewStyle_Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ми надішлемо на введену пошту лист для зміни пароля"
        android:textColor="@color/gray"
        app:layout_constraintBottom_toTopOf="@+id/editText_sendEmailLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.531"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewForgotPassword1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/editText_sendEmailLayout"
        style="@style/EditText_Transparent"
        android:layout_marginStart="@dimen/cardview_compat_inset_shadow"
        android:layout_marginEnd="@dimen/cardview_compat_inset_shadow"

        app:layout_constraintBottom_toTopOf="@+id/button_send"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewForgotPassword1">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_sendEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Пошта"
            android:maxLines="1"
            android:minHeight="48dp" />
    </com.google.android.material.textfield.TextInputLayout>


    <Button
        android:id="@+id/button_send"
        style="@style/ButtonStyle_Gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Надіслати лист"
        app:layout_constraintBottom_toTopOf="@+id/textView_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@+id/textView_back"
        app:layout_constraintEnd_toStartOf="@+id/textView_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView_back"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView_back"
        style="@style/TextViewStyle_Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Повернутись до авторизації"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.222"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.977" />

</androidx.constraintlayout.widget.ConstraintLayout>